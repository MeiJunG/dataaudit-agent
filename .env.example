# Copy this file to .env and fill in your own model service.
# Any OpenAI-compatible chat endpoint that supports function (tool) calling works.
# After editing, run:  python -m src.model_check

# --- Model service (pick ONE block) -----------------------------------------
# Local llama.cpp / vLLM / LM Studio (default used during development)
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=local
MODEL_NAME=qwen2.5-7b-instruct

# Ollama (run: ollama pull qwen2.5:7b)
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# MODEL_NAME=qwen2.5:7b

# Hosted APIs: use the provider's OpenAI-compatible base URL, your own key and a model
# that supports tool calling, for example:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-...your key...
# MODEL_NAME=deepseek-chat
#
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-...your key...
# MODEL_NAME=qwen-plus

# --- Agent and request limits -----------------------------------------------
MAX_AGENT_STEPS=6
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0
LLM_MAX_OUTPUT_TOKENS=256
# LLM_TEMPERATURE=0
# Only for Qwen3-style servers that accept chat_template_kwargs:
# LLM_ENABLE_THINKING=false

# --- Uploads ------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_ROWS=200000
MAX_COLUMNS=200

# --- Web server ---------------------------------------------------------------
# DATAAUDIT_PORT=7860
# 127.0.0.1 = only this computer. Use 0.0.0.0 only behind your own login/firewall:
# the app has no user accounts.
# DATAAUDIT_HOST=127.0.0.1
# Where sessions and upload copies are stored (default ./data):
# DATAAUDIT_DATA_DIR=./data
# STORE_MAX_MB=500
# STORE_MAX_FILES=60
# STORE_RETENTION_DAYS=30
